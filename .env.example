# ─── Environment ──────────────────────────────────────────────────────────────
# 'production' disables test endpoints and enables production guards.
# Set automatically by Railway; set manually for local production testing.
NODE_ENV=development

# ─── Multi-tenant (community) mode ───────────────────────────────────────────
# Path to the SQLite database file (created automatically if missing).
# Local:   DATABASE_PATH=./data/naveens.sqlite  (run: mkdir -p data)
# Railway: DATABASE_PATH=/data/naveens.sqlite   (mount volume at /data)
DATABASE_PATH=./data/naveens.sqlite

# ─── Payment mode ─────────────────────────────────────────────────────────────
# 'coinbase'  → real x402 payments via Coinbase facilitator (production)
# 'mock'      → simulated payments, no real money (development/testing)
X402_MODE=mock

# Coinbase x402 facilitator URL
# Testnet (Base Sepolia):  https://x402.org/facilitator
# Mainnet (Base Mainnet):  https://facilitator.coinbase.com
FACILITATOR_URL=https://x402.org/facilitator

# Blockchain network
# Testnet: eip155:84532  (Base Sepolia — use with https://x402.org/facilitator)
# Mainnet: eip155:8453   (Base Mainnet — use with https://facilitator.coinbase.com)
NETWORK=eip155:84532

# ─── Default tenant (Naveen) seed values ──────────────────────────────────────
# These are used to seed /p/naveen on first boot if the DB is empty.
DRIVER_USDC_WALLET=0xYourWalletAddressHere
DRIVER_NAME=Naveen
DRIVER_CITY=Batticaloa
DRIVER_COUNTRY=Sri Lanka
DRIVER_PHONE=+94XXXXXXXXX
DRIVER_WHATSAPP=+94XXXXXXXXX
LKR_PER_USDC=300

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4021
# Set to your public URL (Railway auto-assigns one, or use your custom domain)
BASE_URL=http://localhost:4021

# ─── Platform fee ─────────────────────────────────────────────────────────────
# Basis points taken as a platform fee on each payment (100 = 1%).
# Set PLATFORM_FEE_WALLET to the address that receives the fee.
# If PLATFORM_FEE_WALLET is not set, no fee is charged.
PLATFORM_FEE_BPS=100
# PLATFORM_FEE_WALLET=0xYourPlatformWalletHere

# ─── Security ─────────────────────────────────────────────────────────────────
# Protects /admin, GET /api/businesses, DELETE /api/businesses/:slug.
# Leave unset for open self-registration (fine for local dev).
# Always set in production.
# ADMIN_SECRET=change-me-in-production

# Manage token for the seeded Naveen tenant.
# Auto-generated on first boot if unset — printed to logs.
# Set explicitly to keep it stable across redeploys.
# NAVEEN_MANAGE_TOKEN=

# ─── Development only ─────────────────────────────────────────────────────────
# Private key used by /api/p/:slug/test-pay (server-side test payments).
# Automatically disabled when NODE_ENV=production.
# TEST_PRIVATE_KEY=0x...
