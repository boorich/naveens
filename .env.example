# ─── Multi-tenant (community) mode ───────────────────────────────────────────
# Path to the SQLite database file (created automatically if missing).
# Setting this enables multi-tenant mode. Run: mkdir -p data
DATABASE_PATH=./data/naveens.sqlite

# ─── Payment mode ─────────────────────────────────────────────────────────────
# 'coinbase'  → real x402 payments via Coinbase facilitator (production)
# 'mock'      → simulated payments, no real money (development/testing)
X402_MODE=coinbase

# Coinbase x402 facilitator URL
FACILITATOR_URL=https://facilitator.coinbase.com

# Blockchain network (Base Sepolia testnet = eip155:84532, Base Mainnet = eip155:8453)
NETWORK=eip155:84532

# ─── Default tenant (Naveen) seed values ──────────────────────────────────────
# These are used to seed /p/naveen on first boot if the DB is empty.
DRIVER_USDC_WALLET=0xYourWalletAddressHere
DRIVER_NAME=Naveen
DRIVER_CITY=Batticaloa
DRIVER_COUNTRY=Sri Lanka
DRIVER_PHONE=+94XXXXXXXXX
DRIVER_WHATSAPP=+94XXXXXXXXX
LKR_PER_USDC=300

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4021
BASE_URL=http://localhost:4021

# ─── Platform fee ─────────────────────────────────────────────────────────────
# Basis points taken as a platform fee on each payment (100 = 1%).
# Set PLATFORM_FEE_WALLET to the address that receives the fee.
# If PLATFORM_FEE_WALLET is not set, no fee is charged.
PLATFORM_FEE_BPS=100
# PLATFORM_FEE_WALLET=0xYourPlatformWalletHere

# ─── Security (optional) ──────────────────────────────────────────────────────
# If set, POST /api/businesses requires the X-Admin-Secret header.
# Leave unset for fully open public self-registration.
# ADMIN_SECRET=change-me-in-production

# Manage token for the seeded Naveen tenant. Auto-generated on first boot if unset.
# NAVEEN_MANAGE_TOKEN=

# ─── Development only ─────────────────────────────────────────────────────────
# Private key used by /api/p/:slug/test-pay (server-side test payments).
# Never set this in production.
# TEST_PRIVATE_KEY=0x...
